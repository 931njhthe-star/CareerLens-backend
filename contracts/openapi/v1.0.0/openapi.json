{
  "openapi": "3.1.0",
  "info": {
    "title": "CareerLens workspace API",
    "version": "1.0.0",
    "description": "Local educational application. Authentication endpoints are documented in docs/api/auth.md. Mutations need the csrf_token from GET /api/v1/auth/session in X-CSRF-Token; credentials are same-origin session cookies. No resume data is sent to an external AI or employer."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5101/api/v1"
    },
    {
      "url": "/api/v1",
      "description": "Same-origin frontend proxy"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Public API health",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/workspace": {
      "get": {
        "summary": "Current authenticated user workspace",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete this user workspace and keep login",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/resume": {
      "put": {
        "summary": "Save reviewed resume; changed input clears report and answers",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeInput"
              }
            }
          }
        }
      }
    },
    "/resume/upload": {
      "post": {
        "summary": "Extract TXT/PDF/DOCX in memory and save editable text",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Upload exceeds request size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "At most 10 MiB; PDF at most 50 pages; extracted text at most 50,000 characters."
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        }
      }
    },
    "/job": {
      "put": {
        "summary": "Save company, role and posting; changes clear report and answers",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobInput"
              }
            }
          }
        }
      }
    },
    "/questions": {
      "get": {
        "summary": "Up to three optional evidence questions",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "questions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Question"
                      }
                    }
                  },
                  "required": [
                    "questions"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/analysis": {
      "post": {
        "summary": "Generate and persist local practice application report",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "report": {
                      "$ref": "#/components/schemas/Report"
                    }
                  },
                  "required": [
                    "report"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisInput"
              }
            }
          }
        }
      }
    },
    "/example": {
      "post": {
        "summary": "Replace this user workspace with synthetic examples",
        "tags": [
          "Workspace"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Login required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing/invalid CSRF or Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "careerlens_session"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "prompt",
          "reason"
        ]
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "excerpt": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "resume",
              "answer"
            ]
          },
          "source_label": {
            "type": "string"
          }
        },
        "required": [
          "excerpt",
          "source",
          "source_label"
        ]
      },
      "Match": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "partial",
              "missing"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "resume",
              "answer",
              "mixed",
              "none"
            ]
          },
          "source_label": {
            "type": "string"
          },
          "evidence_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contextual": {
            "type": "boolean"
          },
          "quantified": {
            "type": "boolean"
          }
        },
        "required": [
          "requirement",
          "evidence",
          "status",
          "source",
          "source_label",
          "evidence_items",
          "matched_terms",
          "missing_terms",
          "contextual",
          "quantified"
        ]
      },
      "Report": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "verdict": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "score": {
                  "type": "integer"
                },
                "max_score": {
                  "type": "integer"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "score",
                "max_score",
                "detail"
              ]
            }
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          },
          "strengths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priorities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "detail"
              ]
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recruiter_email": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "subject",
              "body"
            ]
          },
          "methodology": {
            "type": "string"
          },
          "analysis_mode": {
            "type": "string",
            "enum": [
              "local_rules"
            ]
          },
          "company": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "requirement_count": {
            "type": "integer"
          },
          "confirmed_count": {
            "type": "integer"
          },
          "partial_count": {
            "type": "integer"
          },
          "missing_count": {
            "type": "integer"
          }
        },
        "required": [
          "score",
          "verdict",
          "summary",
          "criteria",
          "matches",
          "strengths",
          "gaps",
          "priorities",
          "questions",
          "recruiter_email",
          "methodology",
          "analysis_mode",
          "company",
          "role",
          "requirement_count",
          "confirmed_count",
          "partial_count",
          "missing_count"
        ]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "resume_text": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "job_text": {
            "type": "string"
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "report": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Report"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "resume_text",
          "filename",
          "company",
          "role",
          "job_text",
          "answers",
          "report",
          "created_at"
        ]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/Draft"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          }
        },
        "required": [
          "draft",
          "questions"
        ]
      },
      "ResumeInput": {
        "type": "object",
        "properties": {
          "resume_text": {
            "type": "string",
            "minLength": 40,
            "maxLength": 50000
          }
        },
        "required": [
          "resume_text"
        ]
      },
      "JobInput": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "job_text": {
            "type": "string",
            "minLength": 40,
            "maxLength": 50000
          }
        },
        "required": [
          "company",
          "role",
          "job_text"
        ]
      },
      "AnalysisInput": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object",
            "description": "Only IDs returned by the current questions endpoint are accepted; omitted answers are empty.",
            "additionalProperties": {
              "type": "string",
              "maxLength": 8000
            }
          }
        },
        "required": []
      }
    }
  }
}
