{
  "openapi": "3.1.0",
  "info": {
    "title": "CareerLens API",
    "version": "1.1.0",
    "description": "Local educational application API for email/OAuth authentication and the resume-to-practice-application workflow. Unsafe requests require the csrf_token from GET /auth/session in X-CSRF-Token and its same-origin session cookie. Resume data is not sent to external AI or employers. Provider and password reset mail configuration: docs/api/auth.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5101/api/v1"
    },
    {
      "url": "/api/v1",
      "description": "Same-origin frontend proxy"
    }
  ],
