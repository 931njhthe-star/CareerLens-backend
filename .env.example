# Copy to .env. These credentials belong to YOUR CareerLens project.
# Blank database URL creates a fresh local SQLite database. Use your own
# sqlite:///relative/path.sqlite3 or postgresql://user:password@host:5432/postgres
# connection URI to connect a different database. This is NOT a Supabase anon key.
DATABASE_URL=
# Local private files (session key and reset mail), independently of DB storage.
# Blank defaults to this repository's .runtime directory.
DATA_DIR=
# Optional local API port; blank defaults to 5101.
BACKEND_PORT=
# Keep this URL identical to the address used in the browser.
PUBLIC_ORIGIN=
# Blank means persist a generated random secret in .runtime/session.key.
CAREERLENS_SECRET_KEY=
SESSION_COOKIE_SECURE=

# Register separate OAuth applications. Callback URLs:
# http://127.0.0.1:5100/api/v1/auth/oauth/google/callback
# http://127.0.0.1:5100/api/v1/auth/oauth/github/callback
# http://127.0.0.1:5100/api/v1/auth/oauth/linkedin/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Default: no external email; reset messages are saved in .runtime/mail/*.eml.
# Set your own SMTP server only when you want real email delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_OUTBOX=
